rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // retocker's Firebase Authentication UID.
    function isRetocker() {
      return request.auth != null
        && request.auth.uid == 'DXBgoKHXkAVW9Rclf1juT6JrMhA2';
    }

    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && uid == request.auth.uid;
    }

    // /users is writable only by the administrator. Its login is the
    // authoritative owner of a settings/Notes namespace.
    function ownsLogin(login) {
      return signedIn()
        && login is string
        && login.size() > 0
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('login', '') == login;
    }

    function isNotesPageId(titleId, ownerKey) {
      return ownerKey is string
        && titleId.size() > ownerKey.size() + 6
        && titleId[0:ownerKey.size() + 6] == ownerKey + '__np__';
    }

    function rootFields(data) {
      return !data.keys().hasAny(['notesPageOwner', 'notesPage']);
    }

    function ownsNotesPage(titleId, data) {
      return ownsLogin(data.get('notesPageOwner', null))
        && isNotesPageId(titleId, data.notesPageOwner);
    }

    // Keep legacy pages readable/editable. Only the namespace owner may
    // normalize a missing/old uid to their own current authenticated UID.
    function notesUidUnchangedOrOwned() {
      return request.resource.data.get('uid', null)
          == resource.data.get('uid', null)
        || owns(request.resource.data.get('uid', null));
    }

    // Profile records are keyed by the Firebase Auth UID.
    match /users/{userId} {
      allow read: if isRetocker()
        || (signedIn() && userId == request.auth.uid);

      allow write: if isRetocker();
    }

    // A persistent per-owner fence serializes bounded asset migrations against
    // ALL journal writers, including old clients and queued offline writes.
    function journalUnlocked(uid) {
      return !existsAfter(/databases/$(database)/documents/journalAssetGuards/$(uid))
        || getAfter(/databases/$(database)/documents/journalAssetGuards/$(uid)).data.locked == false;
    }
    function journalTargetAllowed(data) {
      let uid = data.uid;
      return journalUnlocked(uid)
        && (!existsAfter(/databases/$(database)/documents/journalAssetGuards/$(uid))
          || !(data.get('asset', '') in getAfter(/databases/$(database)/documents/journalAssetGuards/$(uid)).data.get('retired', [])));
    }
    // Re-adding a retired name is an explicit owner action in the asset
    // settings. Only such a write may shrink `retired`: it must leave the fence
    // unlocked and bump the revival counter by exactly one in the same commit.
    // The counter itself never goes back.
    function journalAssetRevivalsValid() {
      let revivals = request.resource.data.get('revivals', 0);
      return revivals is int && revivals >= resource.data.get('revivals', 0);
    }
    function journalAssetRevival() {
      return request.resource.data.locked == false
        && request.resource.data.get('revivals', 0) == resource.data.get('revivals', 0) + 1;
    }
    match /journalAssetGuards/{uid} {
      allow read: if isRetocker() || owns(uid);
      allow create: if (isRetocker() || owns(uid))
        && request.resource.data.uid == uid
        && request.resource.data.locked is bool
        && request.resource.data.retired is list
        && request.resource.data.retired.size() <= 500;
      allow update: if (isRetocker() || owns(uid))
        && request.resource.data.uid == uid
        && request.resource.data.locked is bool
        && request.resource.data.retired is list
        && request.resource.data.retired.size() <= 500
        && journalAssetRevivalsValid()
        && (request.resource.data.retired.hasAll(resource.data.retired)
          || journalAssetRevival());
      // Tombstones are never deleted. A name leaves `retired` only through an
      // explicit, counted revival; stale writes stay fenced until then.
      allow delete: if false;
    }

    // Missing numeric fields remain compatible with old records. Any supplied
    // numbers must obey the same supported range as the journal form.
    function tradeNumbersValid(data) {
      let r = data.get('r', 0);
      let risk = data.get('riskPercent', 1);
      return r is number && r >= -1000000 && r <= 1000000
        && risk is number && risk >= 0 && risk <= 100;
    }
    function tradeNumbersUpdateValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['r', 'riskPercent'])
        || tradeNumbersValid(request.resource.data);
    }

    // Trade ids are rendered inside the administrator's view of a student
    // journal. Every client generates [0-9a-z]+ ids; refuse markup/quotes.
    function journalRecordId(id) {
      return id is string && id.matches('^[A-Za-z0-9_-]{1,128}$');
    }

    // Trades are owned by the UID stored in the document.
    match /trades/{tradeId} {
      allow read: if isRetocker()
        || owns(resource.data.uid);

      allow create: if (isRetocker() || owns(request.resource.data.uid))
        && journalRecordId(tradeId)
        && tradeNumbersValid(request.resource.data)
        && request.resource.data.direction in ['LONG','SHORT']
        && journalTargetAllowed(request.resource.data);

      allow update: if tradeNumbersUpdateValid() && journalUnlocked(resource.data.uid) && journalTargetAllowed(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['direction']) || request.resource.data.direction in ['LONG','SHORT'])
        && (isRetocker()
        || (
          owns(resource.data.uid)
          && request.resource.data.uid == resource.data.uid
        ));

      allow delete: if journalUnlocked(resource.data.uid)
        && (isRetocker() || owns(resource.data.uid));
    }

    function imageTradeOwned(data) {
      let id = data.tradeId;
      return id is string && id.size() > 0
        && ((existsAfter(/databases/$(database)/documents/trades/$(id))
          && getAfter(/databases/$(database)/documents/trades/$(id)).data.uid == data.uid)
          || (existsAfter(/databases/$(database)/documents/backtestTrades/$(id))
          && getAfter(/databases/$(database)/documents/backtestTrades/$(id)).data.uid == data.uid));
    }

    // Private chart images. Saved atomically together with their trade.
    match /tradeImages/{imageId} {
      allow read: if isRetocker() || owns(resource.data.uid);
      allow create: if journalUnlocked(request.resource.data.uid) && (isRetocker() || owns(request.resource.data.uid))
        && imageTradeOwned(request.resource.data)
        && request.resource.data.keys().hasOnly(['id','uid','tradeId','data'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 650000;
      allow update: if journalUnlocked(resource.data.uid) && (isRetocker() || owns(resource.data.uid))
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.tradeId == resource.data.tradeId
        && imageTradeOwned(request.resource.data)
        && request.resource.data.keys().hasOnly(['id','uid','tradeId','data'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 650000;
      allow delete: if journalUnlocked(resource.data.uid) && (isRetocker() || owns(resource.data.uid));
    }

    // Diary entries follow the same ownership model as trades.
    match /diary/{entryId} {
      allow read: if isRetocker()
        || owns(resource.data.uid);

      allow create: if isRetocker()
        || owns(request.resource.data.uid);

      allow update: if isRetocker()
        || (
          owns(resource.data.uid)
          && request.resource.data.uid == resource.data.uid
        );

      allow delete: if isRetocker()
        || owns(resource.data.uid);
    }

    // Root settings: titles/<login>.
    // Notes pages: titles/<login>__np__<pageId>.
    match /titles/{titleId} {
      allow get: if isRetocker()
        || (
          ownsLogin(titleId)
          && (
            !exists(/databases/$(database)/documents/titles/$(titleId))
            || owns(resource.data.get('uid', null))
          )
        )
        || ownsNotesPage(titleId, resource.data);

      // Notes recovery uses where('notesPageOwner', '==', login).
      allow list: if isRetocker()
        || ownsLogin(resource.data.notesPageOwner);

      allow create: if (!request.resource.data.keys().hasAny(['assets','deletedAssets']) || journalUnlocked(request.resource.data.get('uid', request.auth.uid)))
        && (isRetocker()
        || (
          ownsLogin(titleId)
          && owns(request.resource.data.get('uid', null))
          && rootFields(request.resource.data)
        )
        || (
          ownsNotesPage(titleId, request.resource.data)
          && (
            !request.resource.data.keys().hasAny(['uid'])
            || owns(request.resource.data.uid)
          )
        ));

      allow update: if (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['assets','deletedAssets','assetRevision']) || (journalUnlocked(resource.data.get('uid', request.resource.data.get('uid', request.auth.uid))) && journalUnlocked(request.resource.data.get('uid', resource.data.get('uid', request.auth.uid))) && ((request.resource.data.assetRevision is int && request.resource.data.assetRevision == resource.data.get('assetRevision', 0) + 1) || (resource.data.get('assetRevision', 0) == 0 && !request.resource.data.keys().hasAny(['assetRevision']) && !existsAfter(/databases/$(database)/documents/journalAssetGuards/$(resource.data.get('uid', request.resource.data.get('uid', request.auth.uid))))))))
        && (isRetocker()
        || (
          ownsLogin(titleId)
          && owns(resource.data.get('uid', null))
          && request.resource.data.get('uid', null) == resource.data.uid
          && rootFields(request.resource.data)
        )
        || (
          ownsNotesPage(titleId, resource.data)
          && request.resource.data.get('notesPageOwner', null)
            == resource.data.notesPageOwner
          && notesUidUnchangedOrOwned()
        ));

      allow delete: if isRetocker()
        || (ownsLogin(titleId) && owns(resource.data.get('uid', null)))
        || ownsNotesPage(titleId, resource.data);
    }

    // The selected site version is global, including the login screen.
    // It contains no user data, so anyone may read the current style;
    // only retocker may change it.
    match /siteConfig/{configId} {
      allow read: if true;
      allow write: if isRetocker();
    }

    match /backtests/{backtestId} {
      allow read: if isRetocker()
        || owns(resource.data.uid);

      allow create: if isRetocker()
        || owns(request.resource.data.uid);

      allow update: if isRetocker()
        || (
          owns(resource.data.uid)
          && request.resource.data.uid == resource.data.uid
        );

      allow delete: if isRetocker()
        || owns(resource.data.uid);
    }

    match /backtestTrades/{tradeId} {
      allow read: if isRetocker()
        || owns(resource.data.uid);

      allow create: if (isRetocker() || owns(request.resource.data.uid))
        && journalRecordId(tradeId)
        && tradeNumbersValid(request.resource.data)
        && request.resource.data.direction in ['LONG','SHORT'];

      allow update: if tradeNumbersUpdateValid() && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['direction']) || request.resource.data.direction in ['LONG','SHORT'])
        && (isRetocker()
        || (
          owns(resource.data.uid)
          && request.resource.data.uid == resource.data.uid
        ));

      allow delete: if isRetocker()
        || owns(resource.data.uid);
    }

    // Immutable snapshots of an explicitly resolved ambiguous account import.
    match /accountHistoryBackups/{backupId} {
      allow read: if isRetocker() || owns(resource.data.uid);
      allow create: if (isRetocker() || owns(request.resource.data.uid))
        && request.resource.data.keys().hasOnly(['uid','accountId','previous','incoming','cloudBefore','chosen','createdAt'])
        && request.resource.data.accountId is string
        && request.resource.data.previous is list && request.resource.data.incoming is list
        && request.resource.data.cloudBefore is list && request.resource.data.chosen is list;
      allow update, delete: if false;
    }

    // NEW: Replay Space chart style templates (profiles).
    // Same ownership model as backtests: each user sees only their own.
    match /replayProfiles/{profileId} {
      allow read: if isRetocker()
        || owns(resource.data.uid);

      allow create: if isRetocker()
        || owns(request.resource.data.uid);

      allow update: if isRetocker()
        || (
          owns(resource.data.uid)
          && request.resource.data.uid == resource.data.uid
        );

      allow delete: if isRetocker()
        || owns(resource.data.uid);
    }

    // Public read-only Notes links (?note=TOKEN).
    // Anyone who has the exact token can read that one shared page snapshot.
    // Nobody can list/enumerate shared links.
    match /notesShares/{token} {
      allow get: if true;
      allow list: if false;

      allow create: if isRetocker()
        || owns(request.resource.data.uid);

      allow update: if isRetocker()
        || (
          owns(resource.data.uid)
          && request.resource.data.uid == resource.data.uid
        );

      allow delete: if isRetocker()
        || owns(resource.data.uid);
    }

    // Original Notes images are private, including when their id is known.
    // Public snapshots use revocable, share-scoped copies below.
    match /notesImages/{imageId} {
      allow get: if isRetocker() || owns(resource.data.uid);
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;

      allow update: if false;

      allow delete: if isRetocker()
        || owns(resource.data.uid);
    }

    match /notesShares/{token}/images/{imageId} {
      allow get: if exists(/databases/$(database)/documents/notesShares/$(token))
        && imageId in get(/databases/$(database)/documents/notesShares/$(token)).data.get('imageIds', [])
        && resource.data.uid == get(/databases/$(database)/documents/notesShares/$(token)).data.uid;
      allow list: if false;
      // Staging is allowed before creating the parent, but the copy is unreadable
      // until the parent explicitly publishes this image id. Cannot copy others' images.
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','data'])
        && request.resource.data.uid == request.auth.uid
        && (!exists(/databases/$(database)/documents/notesShares/$(token))
          || get(/databases/$(database)/documents/notesShares/$(token)).data.uid == request.auth.uid)
        && get(/databases/$(database)/documents/notesImages/$(imageId)).data.uid == request.auth.uid
        && request.resource.data.data == get(/databases/$(database)/documents/notesImages/$(imageId)).data.data;
      allow delete: if isRetocker() || owns(resource.data.uid);
    }

    // Myfxbook history cache. The client reads known IDs, never lists this collection.
    match /accountSnapshots/{snapshotId} {
      function ownSnapshotId() {
        return signedIn()
          && snapshotId.size() > request.auth.uid.size() + 5
          && snapshotId[0:request.auth.uid.size() + 5]
            == 'mfb_' + request.auth.uid + '_';
      }

      allow get: if isRetocker()
        || (
          ownSnapshotId()
          && (
            !exists(/databases/$(database)/documents/accountSnapshots/$(snapshotId))
            || owns(resource.data.get('uid', null))
          )
        );

      allow create: if request.resource.data.get('historyRevision', 0) in [0, 1]
        && request.resource.data.history is list
        && (isRetocker() || (ownSnapshotId() && owns(request.resource.data.get('uid', null))));

      allow update: if ((request.resource.data.historyRevision is int
        && request.resource.data.historyRevision == resource.data.get('historyRevision', 0) + 1)
        || (resource.data.get('historyRevision', 0) == 0 && !request.resource.data.keys().hasAny(['historyRevision'])))
        && request.resource.data.history is list
        && (isRetocker()
        || (
          ownSnapshotId()
          && owns(resource.data.get('uid', null))
          && request.resource.data.get('uid', null) == resource.data.uid
        ));

      allow delete: if isRetocker()
        || (ownSnapshotId() && owns(resource.data.get('uid', null)));
    }


    // Movie/series tracker.
    match /movieTrackerApp/mt_d51e19c9c35f0d8fe46d560e7fc3d1a6 {
      allow read, write: if true;
    }

    // Deny everything not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}