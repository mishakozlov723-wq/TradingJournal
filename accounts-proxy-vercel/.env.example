# Required
FIREBASE_WEB_API_KEY=
# At least 32 random bytes. If empty, the key is derived from FIREBASE_SERVICE_ACCOUNT.
ACCOUNTS_CREDENTIAL_SECRET=
# Full JSON of a Firebase service account key (one line). Without it every Accounts request
# answers 503 REVOCATION_NOT_CONFIGURED. Its project_id must equal FIREBASE_PROJECT_ID.
FIREBASE_SERVICE_ACCOUNT=
# Recommended: exact HTTPS origins allowed to call the proxy (CORS), comma-separated.
# Empty or * = only https://retocker.web.app and https://retocker.firebaseapp.com.
ALLOWED_ORIGIN=https://retocker.web.app
# Optional:
# FIREBASE_PROJECT_ID=retocker
# ACCOUNTS_ENFORCE_ALLOWLIST=1
# ALLOWED_FIREBASE_UIDS=
# Old tokens only (read-only, time-limited; never used for new tokens):
# MYFXBOOK_PASSWORD=
