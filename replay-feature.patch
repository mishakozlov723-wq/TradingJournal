@@ -113,6 +113,11 @@ body.replay-fullscreen .autumn-leaf, body.replay-fullscreen .winter-snowflake {
 #rpChart { position:absolute; inset:0; }
 .rp-legend { position:absolute; z-index:5; left:14px; top:10px; pointer-events:none; font-size:12px; color:var(--textDim); display:flex; flex-wrap:wrap; gap:4px 12px; }
