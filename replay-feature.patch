+.rp-tf-overlay { display:none; position:absolute; z-index:8; left:50%; top:50%; transform:translate(-50%,-50%); min-width:112px; padding:14px 18px 12px; border:1px solid rgba(255,255,255,.22); border-radius:14px; background:rgba(12,14,19,.94); color:var(--textMain); box-shadow:0 18px 48px rgba(0,0,0,.48); text-align:center; pointer-events:none; backdrop-filter:blur(12px); }
