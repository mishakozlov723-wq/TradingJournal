+@keyframes rpTfIn { from { opacity:0; transform:translate(-50%,-46%) scale(.96); } to { opacity:1; transform:translate(-50%,-50%) scale(1); } }
 .rp-banner { display:none; position:absolute; z-index:6; left:50%; bottom:46px; transform:translateX(-50%); background:rgba(12,14,19,.94); border:1px solid rgba(255,255,255,.14); border-radius:14px; padding:10px 16px; font-size:13px; box-shadow:0 14px 34px rgba(0,0,0,.4); }
