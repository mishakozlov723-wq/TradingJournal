{
  "name": "syter-desktop",
  "productName": "SYTER",
  "version": "1.2.1",
  "description": "SYTER Trading Journal",
  "author": "SYTER",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --x64 --publish never && node scripts/publish-update.js",
    "release": "npm version patch --no-git-tag-version && npm run build"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.retocker.syter",
    "productName": "SYTER",
    "copyright": "SYTER",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "mini-journal.js",
      "mini-journal.css",
      "offline.html",
      "titlebar.html",
      "build/icon.ico",
      "build/titlebar-icon.png",
      "package.json",
      "mini-journal-legacy.js"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "SYTER-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SYTER",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mishakozlov723-wq",
        "repo": "syter-releases",
        "releaseType": "release"
      }
    ]
  }
}
