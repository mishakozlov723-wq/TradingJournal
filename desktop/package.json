{
  "name": "syter-desktop",
  "productName": "SYTER",
  "version": "1.3.17",
  "description": "SYTER Trading Journal",
  "author": "SYTER",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/mini-shortcut.test.cjs tests/window-motion.test.cjs tests/cover-presentation.test.cjs tests/mini-mode-main.test.cjs tests/link-routing.test.cjs tests/view-layout.test.cjs tests/window-width-policy.test.cjs tests/interface-preview-shortcut.test.cjs tests/user-release.test.cjs tests/lifecycle.test.cjs tests/pr3-desktop.test.cjs tests/shutdown.test.cjs",
    "build": "node scripts/prepare-progress-nsis.js && node scripts/build-progress-nsis.js && node scripts/publish-update.js && node scripts/build-branded-installer.js",
    "release": "npm version patch --no-git-tag-version && npm run build"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "42.11.12",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.retocker.syter",
    "productName": "SYTER",
    "copyright": "SYTER",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "mini-shortcut.js",
      "window-motion.js",
      "preload.js",
      "mini-journal.js",
      "mini-journal.css",
      "offline.html",
      "titlebar.html",
      "build/icon.ico",
      "build/titlebar-icon.png",
      "package.json",
      "mini-journal-legacy.js",
      "mini-view-state.js",
      "view-layout.js",
      "window-bounds.js",
      "build/app-icon.png",
      "build/tray-icon.png",
      "window-width-policy.js",
      "autumn-motion.js",
      "interface-preview-shortcut.js",
      "lifecycle/**/*",
      "build/ui/**/*",
      "return-compositor.js",
      "cover-presentation.js",
      "mode-transition.html",
      "mode-transition.css",
      "mode-transition.js",
      "tray-menu.js",
      "tray-menu/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "SYTER-Setup-${version}.${ext}",
      "verifyUpdateCodeSignature": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SYTER",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "installer/custom-install.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mishakozlov723-wq",
        "repo": "syter-releases",
        "releaseType": "release"
      }
    ],
    "forceCodeSigning": false
  },
  "syterUpdatePolicy": "github"
}
